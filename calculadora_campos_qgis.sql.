/* =====================================================================
   TFM: VULNERABILIDAD A INCENDIOS FORESTALES EN GALICIA (ENFOQUE ICA)
   =====================================================================
   Recopilación de expresiones SQL utilizadas en la Calculadora de Campos 
   de QGIS para la normalización de variables, cálculo de subíndices y 
   clasificación del riesgo.
====================================================================== */

/* ---------------------------------------------------------------------
   1. DIMENSIÓN SOCIAL (ReSVI_social)
--------------------------------------------------------------------- */

-- 1.1. Cálculo de porcentajes demográficos por celda 
-- Se incluye un condicional (CASE WHEN) para evitar errores matemáticos 
-- (división por cero) en las celdas del rural afectadas por despoblamiento masivo.

-- Porcentaje de población mayor de 65 años (porcen_may):
CASE 
  WHEN "pob_total_sum" > 0 THEN ("poblacion_may_sum" / "pob_total_sum") * 100 
  ELSE 0 
END;

-- Porcentaje de población infantil (porcen_inf):
CASE 
  WHEN "pob_total_sum" > 0 THEN ("poblacion_inf_sum" / "pob_total_sum") * 100 
  ELSE 0 
END;

-- 1.2. Normalización Min-Max (Escala 0 a 1)
-- Fórmula base aplicada a variables absolutas para su estandarización.
-- ("nombre_del_campo" - valor_minimo) / (valor_maximo - valor_minimo)

-- 1.3. Cálculo del Subíndice Social
-- Agrupación equitativa de las cuatro variables normalizadas.
("v_mayores" + "v_infantil" + "v_estudios" + "v_renta") / 4;


/* ---------------------------------------------------------------------
   2. DIMENSIÓN NATURAL (ReSVI_Natu)
--------------------------------------------------------------------- */

-- 2.1. Asignación de vulnerabilidad por tipo de combustible
-- Transformación de los códigos forestales del proyecto FirEUrisk 
-- a valores normalizados de peligrosidad (0 a 1).
CASE
  WHEN "combustibl" IN (7, 61) THEN 0.00
  WHEN "combustibl" IN (41, 42, 62) THEN 0.25
  WHEN "combustibl" IN (1121, 1122) THEN 0.50
  WHEN "combustibl" IN (23, 31, 32, 1301, 1302) THEN 0.75
  WHEN "combustibl" IN (51, 52, 53, 1211, 1212) THEN 1.00
  ELSE NULL
END;

-- 2.2. Cálculo del Subíndice Natural 
-- Integración del combustible con la resiliencia del ecosistema y su valor ecológico.
("v_combusti" + "v_resilien" + "v_valor_ec") / 3;


/* ---------------------------------------------------------------------
   3. DIMENSIÓN ECONÓMICA (ReSVI_Econ)
--------------------------------------------------------------------- */

-- 3.1. Cálculo del Subíndice Económico
-- Integración de las infraestructuras críticas expuestas.
("v_torres" + "v_lineas" + "v_convenci" + "v_tren_ave") / 4;


/* ---------------------------------------------------------------------
   4. DIMENSIÓN DE PREVENCIÓN (ReSVI_Prev)
--------------------------------------------------------------------- */

-- 4.1. Cálculo del Subíndice de Prevención 
-- Agrupación de tiempos de respuesta y dotaciones (isócronas).
("v_bomberos" + "v_puntos_a" + "v_def_pasi") / 3;


/* ---------------------------------------------------------------------
   5. ÍNDICE GLOBAL Y VALIDACIÓN ESTADÍSTICA
--------------------------------------------------------------------- */

-- 5.1. Cálculo del Índice de Vulnerabilidad Global (ReSVI Final)
-- Enfoque de Capitales Integrados (ICA): 25% de peso para cada dimensión.
("ReSVI_Natu" + "ReSVI_Econ" + "ReSVI_social" + "ReSVI_Prev") / 4;

-- 5.2. Conversión a Hectáreas 
-- Tras la intersección espacial con los perímetros de incendios históricos (2000-2023).
$area / 10000;

-- 5.3. Reclasificación en 5 Categorías de Vulnerabilidad 
-- Basado en los umbrales de cortes naturales (Método de Jenks).
CASE
  WHEN "ReSVI_fin" < 0.40 THEN '1_Baja'
  WHEN "ReSVI_fin" >= 0.40 AND "ReSVI_fin" <= 0.47 THEN '2_Media'
  WHEN "ReSVI_fin" > 0.47 AND "ReSVI_fin" <= 0.53 THEN '3_Alta'
  WHEN "ReSVI_fin" > 0.53 AND "ReSVI_fin" <= 0.59 THEN '4_Muy_Alta'
  WHEN "ReSVI_fin" > 0.59 THEN '5_Extrema'
END;
